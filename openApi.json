{
  "openapi": "3.0.3",
  "info": {
    "title": "Polar Management Plugin API",
    "version": "1.0.0",
    "description": "REST API for canonical v1 polarTable and v2 polarSet resources. Versions and all nested information are preserved; no automatic migration.\nAll speed values are in m/s, all angles in radians. V2 root units/symmetry and optional vessel-wide wave correction apply to independently gridded best and descriptive sailplan tables. Inventory ownership is outside this API.\nThe same 'polars' resource type is exposed via /signalk/v2/api/resources/polars/<id>, preferred for CRUD consumers.\nThe internal /polars/{id}/curves webapp endpoint is intentionally not part of this contract. V2 curves require compatible polar-math and return explicit 503 with published 1.1.1; numeric display/storage/import/export work independently. All active-polar consumers must support v2 before activation.",
    "x-route-access": "Signal K read-only users can access GET /polars, /polars/{id}, /polars/{id}/curves, /polars/{id}/validate, /internet, /activePolar, /performanceFactor, /imports/formats, /imports/sources, /exports/formats, /polars/{id}/export/{format}. External-source searches and all mutation routes require administrator access. Anonymous access follows the server's security configuration."
  },
  "servers": [
    { "url": "/plugins/signalk-polar-management" }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"]
      },
      "PolarSummary": {
        "type": "object",
        "description": "Light metadata for a stored polar, without axes/matrix.",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "boatType": { "type": "string" },
          "sailnumber": { "type": "string" },
          "year": { "type": "integer" },
          "source": { "type": "string" },
          "notes": { "type": "string" },
          "kind": { "type": "string", "enum": ["polarSet"] },
          "schemaVersion": { "type": "string" },
          "tables": { "type": "array", "description": "V2 local display/export choices; absent id means best, supplied id is document-local.", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } }, "required": ["name"] } },
          "error": { "type": "string", "description": "Explicit storage read error, if the document could not be summarized." },
          "hasDerived": { "type": "boolean" }
        },
        "required": ["id"]
      },
      "CanonicalPolarResource": {
        "type": "object",
        "description": "Canonical polar-format v1 polarTable or v2 polarSet. Root descriptive metadata/context is not embedded table metadata. Full structural and semantic validation uses polar-format 2. See its schemas for all optional auxiliary, target, attribution and wave data; this API outline is not a substitute for that validation.",
        "properties": {
          "kind": { "type": "string", "enum": ["polarTable", "polarSet"] },
          "schemaVersion": { "type": "string", "enum": ["1.0.0", "2.0.0"] },
          "name": { "type": "string" },
          "boatType": { "type": "string" },
          "sailnumber": { "type": "string" },
          "year": { "type": "integer" },
          "source": { "type": "string" },
          "notes": { "type": "string" },
          "units": { "type": "object" },
          "symmetry": { "type": "object" },
          "axes": { "type": "object" },
          "values": { "type": "object" },
          "derived": { "type": "object" },
          "best": { "type": "object", "description": "V2 required embedded table with own axes/values/derived; supplied envelope is authoritative." },
          "sailplans": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "sails": { "type": "array", "items": { "type": "object" } }, "notes": { "type": "string" }, "table": { "type": "object" } }, "required": ["id", "name", "table"] } },
          "waveCorrection": { "type": "object" }
        },
        "required": ["kind", "schemaVersion", "units", "symmetry"],
        "oneOf": [
          { "properties": { "kind": { "enum": ["polarTable"] }, "schemaVersion": { "enum": ["1.0.0"] } }, "required": ["axes", "values"] },
          { "properties": { "kind": { "enum": ["polarSet"] }, "schemaVersion": { "enum": ["2.0.0"] } }, "required": ["best"] }
        ]
      },
      "ValidationResult": {
        "type": "object",
        "properties": {
          "valid": { "type": "boolean" },
          "errors": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["valid", "errors"]
      },
      "ImportFormatDescriptor": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["id", "name"]
      },
      "ImportSourceDescriptor": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "cached": { "type": "boolean" }
        },
        "required": ["id", "name"]
      },
      "ImportSourceMatch": {
        "type": "object",
        "description": "One search result from an external import source (e.g. an ORC active certificate).",
        "properties": {
          "externalId": { "type": "string" },
          "name": { "type": "string" },
          "sailnumber": { "type": "string" },
          "boatType": { "type": "string" },
          "year": { "type": "integer" },
          "source": { "type": "string" }
        },
        "required": ["externalId", "name"]
      },
      "ImportResult": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "resource": { "$ref": "#/components/schemas/CanonicalPolarResource" }
        },
        "required": ["id", "resource"]
      }
    }
  },
  "paths": {
    "/polars": {
      "get": {
        "operationId": "listPolars",
        "summary": "List all stored polars with light metadata",
        "responses": {
          "200": {
            "description": "Array of stored polar summaries, including local v2 table choices where available",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PolarSummary" } } } }
          }
        }
      }
    },
    "/polars/{id}": {
      "get": {
        "operationId": "getPolar",
        "summary": "Get a stored canonical polar resource",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Canonical polar resource", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalPolarResource" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "put": {
        "operationId": "putPolar",
        "summary": "Create or replace a canonical polar resource",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalPolarResource" } } }
        },
        "responses": {
          "200": { "description": "Saved", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "operationId": "deletePolar",
        "summary": "Delete a stored polar (not allowed while active)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Polar is active", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/polars/{id}/validate": {
      "get": {
        "operationId": "validatePolar",
        "summary": "Validate a stored polar against polar-format",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Validation result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationResult" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/polars/{id}/copy": {
      "post": {
        "operationId": "copyPolar",
        "summary": "Duplicate a stored polar under a new id",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } } }
        },
        "responses": {
          "200": { "description": "Copied", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } } } },
          "400": { "description": "Missing id or id already exists", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/polars/{id}/metadata": {
      "put": {
        "operationId": "modifyPolarMetadata",
        "summary": "Modify boat metadata and optionally change the polar id",
        "description": "Preserves polar speed data, source and notes. Omitted fields are unchanged; empty strings clear optional text fields and null clears year. Changing an active polar's id also persists and publishes its new active selection.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "name": { "type": "string" },
                  "boatType": { "type": "string" },
                  "sailnumber": { "type": "string" },
                  "year": { "type": "integer", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Saved", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } } } },
          "400": { "description": "Invalid metadata or id already exists", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Polar not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "description": "Active selection could not be persisted; changes are rolled back unless the error reports a restore failure", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/polars/{id}/rename": {
      "post": {
        "operationId": "renamePolar",
        "summary": "Rename a stored polar",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } } }
        },
        "responses": {
          "200": { "description": "Renamed", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } } } },
          "400": { "description": "Missing id or id already exists", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/polars/{id}/export/{format}": {
      "get": {
        "operationId": "exportPolar",
        "summary": "Export a complete canonical document, or an explicitly selected single-table projection",
        "description": "json preserves the version and every field, including nulls, auxiliary/target data, references and wave correction; table selection is incompatible. V2 single-table formats require scope=table and acknowledgeLoss=true, and default to best when sailplanId is omitted. They discard other tables, sail descriptions, wave correction, auxiliary data and winning references. json-v1 is an explicitly lossy v1 projection, not lossless canonical v2 export. Root boat metadata remains root context. Text formats additionally round numbers and may lose target details. Missing speeds are rejected, never filled. Legacy v1 exports remain available without new acknowledgment.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "format", "in": "path", "required": true, "schema": { "type": "string", "enum": ["json", "json-v1", "jieter", "expedition"] } },
          { "name": "scope", "in": "query", "schema": { "type": "string", "enum": ["table"] }, "description": "Required for v2 single-table projection; forbidden for complete json." },
          { "name": "sailplanId", "in": "query", "schema": { "type": "string", "minLength": 1 }, "description": "Select v2 document-local sailplan. Omit for best. Unknown IDs are errors, not fallbacks. Forbidden for complete json and v1 documents." },
          { "name": "acknowledgeLoss", "in": "query", "schema": { "type": "boolean" }, "description": "Must be true for any v2 single-table projection." }
        ],
        "responses": {
          "200": { "description": "Exported file, returned as an attachment", "content": { "application/json": {}, "text/plain": {} } },
          "400": { "description": "Unsupported format or export error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/exports/formats": {
      "get": {
        "operationId": "listExportFormats",
        "summary": "List supported export formats, including canonical json",
        "responses": {
          "200": { "description": "Array of export format descriptors", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ImportFormatDescriptor" } } } } }
        }
      }
    },
    "/activePolar": {
      "get": {
        "operationId": "getActivePolar",
        "summary": "Get the currently active polar id and its validity",
        "responses": {
          "200": {
            "description": "Active polar status",
            "content": { "application/json": { "schema": { "type": "object", "properties": {
              "id": { "type": "string", "nullable": true },
              "exists": { "type": "boolean" },
              "valid": { "type": "boolean" },
              "errors": { "type": "array", "items": { "type": "string" } }
            }, "required": ["id", "exists", "valid", "errors"] } } }
          }
        }
      },
      "put": {
        "operationId": "setActivePolar",
        "summary": "Set the active document id; publishes the unchanged vessels.self.polars.activePolar resource pointer",
        "description": "Selects a complete document, never a local display/export sailplan. V2 requires acknowledgeV2=true after ensuring every active-polar consumer supports v2. No capability detection or shared active-sailplan path is provided.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string", "nullable": true }, "acknowledgeV2": { "type": "boolean" } } } } }
        },
        "responses": {
          "200": { "description": "Active polar set", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string", "nullable": true } } } } } },
          "400": { "description": "Invalid id or document", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "V2 consumer-rollout acknowledgment required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Polar not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/performanceFactor": {
      "get": {
        "operationId": "getPerformanceFactor",
        "summary": "Get the shared polar performance factor",
        "responses": {
          "200": { "description": "1.0 means unchanged polar speed", "content": { "application/json": { "schema": { "type": "object", "properties": { "value": { "type": "number", "minimum": 0, "maximum": 1 } }, "required": ["value"] } } } }
        }
      },
      "put": {
        "operationId": "setPerformanceFactor",
        "summary": "Set the shared polar performance factor; publishes vessels.self.polars.performanceFactor for use by other plugins",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "value": { "type": "number", "minimum": 0, "maximum": 1 } }, "required": ["value"] } } }
        },
        "responses": {
          "200": { "description": "Factor set", "content": { "application/json": { "schema": { "type": "object", "properties": { "value": { "type": "number" } }, "required": ["value"] } } } },
          "400": { "description": "Out of range", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/imports/formats": {
      "get": {
        "operationId": "listImportFormats",
        "summary": "List supported text import formats",
        "responses": {
          "200": { "description": "Array of import format descriptors", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ImportFormatDescriptor" } } } } }
        }
      }
    },
    "/imports/text/{format}": {
      "post": {
        "operationId": "importText",
        "summary": "Import a polar from pasted/uploaded text in a given format",
        "description": "Use auto for automatic detection, including ORC speed-guide HTML (orc-speed-guide), canonical v1/v2 JSON, Jieter, Expedition and TimeZero wind XML. Existing vendor importers still produce v1; canonical import preserves the version. ORC HTML produces v2, reads inert numeric tables and optional embedded scalar SYLK (no standalone SYLK import), preserves independent source targets and normalizes exact ORC 0.01-knot placeholders to null speed/auxiliary cells with placeholder targets omitted. Real zero and other low speeds remain numeric. Malformed/conflicting embedded data is rejected, AWS/AWA are omitted.",
        "parameters": [{ "name": "format", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "content": { "type": "string" }, "name": { "type": "string" }, "sailnumber": { "type": "string" }, "boatType": { "type": "string" }, "year": { "type": "integer" }, "source": { "type": "string" }, "notes": { "type": "string" } }, "required": ["content"] } } }
        },
        "responses": {
          "200": { "description": "Imported and stored", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportResult" } } } },
          "400": { "description": "Parse or validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/imports/sources": {
      "get": {
        "operationId": "listImportSources",
        "summary": "List supported external import sources (e.g. ORC)",
        "responses": {
          "200": { "description": "Array of import source descriptors", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ImportSourceDescriptor" } } } } }
        }
      }
    },
    "/imports/sources/{source}/search": {
      "get": {
        "operationId": "searchImportSource",
        "summary": "Search an external source (e.g. ORC active certificates)",
        "parameters": [
          { "name": "source", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Array of matches", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ImportSourceMatch" } } } } },
          "404": { "description": "Unsupported source", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "No internet connection or source unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/imports/sources/{source}/items/{externalId}": {
      "post": {
        "operationId": "importFromSource",
        "summary": "Import a polar by external id from a source (e.g. ORC certificate)",
        "parameters": [
          { "name": "source", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "externalId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Imported and stored", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportResult" } } } },
          "404": { "description": "Unsupported source or external id not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "No internet connection or source unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/internet": {
      "get": {
        "operationId": "getInternetStatus",
        "summary": "Lightweight connectivity probe used to gate external-source imports",
        "responses": {
          "200": { "description": "Connectivity status", "content": { "application/json": { "schema": { "type": "object", "properties": { "online": { "type": "boolean" } }, "required": ["online"] } } } }
        }
      }
    }
  }
}
